{
    "compilerOptions": {
        "outDir": "./dist/",
        "noImplicitAny": false,
        "module": "ES2020",
        "target": "ES2020",
        "moduleResolution": "node",
        "sourceMap": true,
        "jsx": "react",
        "allowJs": true,
        "experimentalDecorators": true,
        "lib": ["ES2020", "dom"],
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "paths": {
            "orion-ecs": ["./orion-ecs-v2/core/dist/index.d.ts"]
        }
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "orion-ecs-v2"
    ]
}